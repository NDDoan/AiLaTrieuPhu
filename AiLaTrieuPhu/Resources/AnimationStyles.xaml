<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--   FLOATING OSCILLATION (Nostalgia Images)              -->
    <!--   NOTE: Chỉ dùng qua code-behind (.Clone() trước khi  -->
    <!--   Begin()) để tránh lỗi Immutable Freezable.           -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Storyboard x:Key="FloatingOscillation" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.X)"
                         From="-12" To="12" Duration="0:0:6" AutoReverse="True">
            <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)"
                         From="-8" To="8" Duration="0:0:5" AutoReverse="True">
            <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(ScaleTransform.ScaleX)"
                         From="0.97" To="1.03" Duration="0:0:8" AutoReverse="True"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(ScaleTransform.ScaleY)"
                         From="0.97" To="1.03" Duration="0:0:8" AutoReverse="True"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[4].(RotateTransform.Angle)"
                         From="-5" To="5" Duration="0:0:10" AutoReverse="True"/>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0.4" To="0.8" Duration="0:0:7" AutoReverse="True"/>
    </Storyboard>

</ResourceDictionary>
