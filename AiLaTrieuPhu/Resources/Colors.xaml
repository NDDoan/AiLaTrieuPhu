<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--                    BASE COLORS                          -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- Deep navy primary background -->
    <Color x:Key="PrimaryBackgroundColor">#FF050514</Color>
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}"/>

    <!-- Slightly lighter secondary background -->
    <Color x:Key="SecondaryBackgroundColor">#FF0D0D28</Color>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}"/>

    <!-- Card / panel surface -->
    <Color x:Key="SurfaceColor">#FF111136</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--                    ACCENT GOLD                          -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Color x:Key="AccentGoldColor">#FFFFD700</Color>
    <SolidColorBrush x:Key="AccentGoldBrush" Color="{StaticResource AccentGoldColor}"/>

    <Color x:Key="AccentGoldDarkColor">#FFFF8C00</Color>
    <SolidColorBrush x:Key="AccentGoldDarkBrush" Color="{StaticResource AccentGoldDarkColor}"/>

    <Color x:Key="AccentGoldLightColor">#FFFFFF99</Color>
    <SolidColorBrush x:Key="AccentGoldLightBrush" Color="{StaticResource AccentGoldLightColor}"/>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--                    NEON BLUE                            -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Color x:Key="NeonBlueColor">#FF3377FF</Color>
    <SolidColorBrush x:Key="NeonBlueBrush" Color="{StaticResource NeonBlueColor}"/>

    <Color x:Key="NeonBlueGlowColor">#882255FF</Color>
    <SolidColorBrush x:Key="NeonBlueGlowBrush" Color="{StaticResource NeonBlueGlowColor}"/>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--                    INTERACTIVE STATES                   -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Color x:Key="HoverColor">#FF2233AA</Color>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>

    <Color x:Key="PressedColor">#FF112266</Color>
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}"/>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--                    STATUS COLORS                        -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Color x:Key="SuccessGreenColor">#FF00C853</Color>
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreenColor}"/>

    <Color x:Key="ErrorRedColor">#FFD50000</Color>
    <SolidColorBrush x:Key="ErrorRedBrush" Color="{StaticResource ErrorRedColor}"/>

    <Color x:Key="SafePointColor">#FF00695C</Color>
    <SolidColorBrush x:Key="SafePointBrush" Color="{StaticResource SafePointColor}"/>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--                    TEXT                                 -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Color x:Key="PrimaryTextColor">#FFF5F5FF</Color>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>

    <Color x:Key="SecondaryTextColor">#FFB0B8CC</Color>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--                    GRADIENT BRUSHES                     -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- Main background gradient: deep navy to dark purple -->
    <LinearGradientBrush x:Key="MainBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF020210" Offset="0"/>
        <GradientStop Color="#FF0A0828" Offset="0.5"/>
        <GradientStop Color="#FF08041A" Offset="1"/>
    </LinearGradientBrush>

    <!-- Gold shimmer gradient for borders / accents -->
    <LinearGradientBrush x:Key="GoldShimmerBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFF8C00" Offset="0"/>
        <GradientStop Color="#FFFFD700" Offset="0.5"/>
        <GradientStop Color="#FFFF8C00" Offset="1"/>
    </LinearGradientBrush>

    <!-- Gold shimmer vertical -->
    <LinearGradientBrush x:Key="GoldShimmerVerticalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFF8C00" Offset="0"/>
        <GradientStop Color="#FFFFD700" Offset="0.5"/>
        <GradientStop Color="#FFFF8C00" Offset="1"/>
    </LinearGradientBrush>

    <!-- Menu button gradient (default) -->
    <LinearGradientBrush x:Key="MenuButtonGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1A1A4A" Offset="0"/>
        <GradientStop Color="#FF0A0A28" Offset="1"/>
    </LinearGradientBrush>

    <!-- Menu button hover gradient -->
    <LinearGradientBrush x:Key="MenuButtonHoverGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF2A3A99" Offset="0"/>
        <GradientStop Color="#FF142266" Offset="1"/>
    </LinearGradientBrush>

    <!-- Answer button A - Blue -->
    <LinearGradientBrush x:Key="AnswerAGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1A3B8C" Offset="0"/>
        <GradientStop Color="#FF0D2060" Offset="1"/>
    </LinearGradientBrush>

    <!-- Answer button B - Red/Orange -->
    <LinearGradientBrush x:Key="AnswerBGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF8C1A1A" Offset="0"/>
        <GradientStop Color="#FF600D0D" Offset="1"/>
    </LinearGradientBrush>

    <!-- Answer button C - Yellow/Amber -->
    <LinearGradientBrush x:Key="AnswerCGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF7A5500" Offset="0"/>
        <GradientStop Color="#FF503300" Offset="1"/>
    </LinearGradientBrush>

    <!-- Answer button D - Green -->
    <LinearGradientBrush x:Key="AnswerDGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1A6B2A" Offset="0"/>
        <GradientStop Color="#FF0D4A18" Offset="1"/>
    </LinearGradientBrush>

    <!-- Question box gradient -->
    <LinearGradientBrush x:Key="QuestionBoxGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1A1650" Offset="0"/>
        <GradientStop Color="#FF0A0A30" Offset="1"/>
    </LinearGradientBrush>

    <!-- Prize ladder current item highlight -->
    <LinearGradientBrush x:Key="PrizeCurrentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#44FFD700" Offset="0"/>
        <GradientStop Color="#22FFD700" Offset="0.5"/>
        <GradientStop Color="#44FFD700" Offset="1"/>
    </LinearGradientBrush>

    <!-- Panel overlay for popups -->
    <SolidColorBrush x:Key="OverlayDarkBrush" Color="#E6000010"/>

    <!-- QuestionBackgroundBrush (legacy compat) -->
    <SolidColorBrush x:Key="QuestionBackgroundBrush" Color="{StaticResource AccentGoldColor}"/>

</ResourceDictionary>