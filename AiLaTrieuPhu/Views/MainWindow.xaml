<Window x:Class="AiLaTrieuPhu.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        xmlns:views="clr-namespace:AiLaTrieuPhu.Views"
        xmlns:vm="clr-namespace:AiLaTrieuPhu.ViewModels"
        
        mc:Ignorable="d"
        Title="Ai Là Triệu Phú - .NET KING Edition" 
        Width="1280" Height="720" MinWidth="960" MinHeight="540" 
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MenuViewModel}">
            <views:MenuScreen/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameViewModel}">
            <views:GameScreen/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsControl/>
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>
