<UserControl x:Class="AiLaTrieuPhu.Views.MenuScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:AiLaTrieuPhu.Utilities"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:views="clr-namespace:AiLaTrieuPhu.Views"
             mc:Ignorable="d" 
             Background="{StaticResource MainBackgroundGradient}">
    <UserControl.Resources>
        <converters:IndexToRandomPosConverter x:Key="IndexToRandomPosConverter"/>
        <converters:CenterConverter x:Key="CenterConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <x:Array x:Key="NostalgiaImages" Type="System:String">
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_1.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_2.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_3.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_4.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_5.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_6.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_7.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_8.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_9.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_10.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_11.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_12.png</System:String>
        </x:Array>
    </UserControl.Resources>

    <Grid>
        <!-- ═══════════════════════════════════════════════════ -->
        <!-- Floating nostalgia images in background             -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Canvas x:Name="FloatingCanvas" ClipToBounds="True"/>

        <ItemsControl x:Name="NostalgiaItems" ItemsSource="{StaticResource NostalgiaImages}" AlternationCount="7">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas IsItemsHost="True"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Image Source="{Binding}" Width="150" Height="Auto" Stretch="Uniform"
                           RenderTransformOrigin="0.5,0.5" Cursor="Hand">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform/>
                                <TranslateTransform/>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                <RotateTransform Angle="0"/>
                                <RotateTransform Angle="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                        <Image.Effect>
                            <DropShadowEffect Color="#000033" BlurRadius="18" ShadowDepth="6" Opacity="0.7"/>
                        </Image.Effect>

                    </Image>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToRandomPosConverter}}"/>
                    <Setter Property="Canvas.Top" Value="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToRandomPosConverter}, ConverterParameter=1}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- Subtle radial vignette overlay                      -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop Color="#00000000" Offset="0.4"/>
                    <GradientStop Color="#CC020210" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- Main overlay UI                                     -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid x:Name="OverlayGrid" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="True">
            <Border CornerRadius="20" Padding="50,40">
                <!-- Glassmorphism card background -->
                <Border.Background>
                    <SolidColorBrush Color="#CC050514"/>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#FFD700" BlurRadius="40" ShadowDepth="0" Opacity="0.15"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- Logo with glow -->
                    <Image x:Name="MenuLogo" 
                           Source="/AiLaTrieuPhu;component/Assets/Image/ALTP_LOGO.png" 
                           Width="220" Height="220"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="LogoScaleTransform" ScaleX="1" ScaleY="1"/>
                        </Image.RenderTransform>
                        <Image.Effect>
                            <DropShadowEffect x:Name="LogoDropShadow" Color="#FFD700" BlurRadius="35" ShadowDepth="0" Opacity="0.8"/>
                        </Image.Effect>
                        <Image.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="LogoScaleTransform" Storyboard.TargetProperty="ScaleX"
                                                         From="0.98" To="1.02" Duration="0:0:2.5" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="LogoScaleTransform" Storyboard.TargetProperty="ScaleY"
                                                         From="0.98" To="1.02" Duration="0:0:2.5" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Image.Triggers>
                    </Image>

                    <!-- Gold divider line -->
                    <Border Height="2" Margin="0,16,0,20" CornerRadius="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFD700" Offset="0"/>
                                <GradientStop Color="#FFFFD700" Offset="0.3"/>
                                <GradientStop Color="#FFFFC200" Offset="0.5"/>
                                <GradientStop Color="#FFFFD700" Offset="0.7"/>
                                <GradientStop Color="#00FFD700" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Status message -->
                    <TextBlock Text="{Binding StatusMessage}" 
                               FontSize="18" 
                               FontFamily="Segoe UI"
                               Foreground="{StaticResource SecondaryTextBrush}" 
                               Margin="0,0,0,20" 
                               HorizontalAlignment="Center" 
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="360"/>

                    <!-- Menu buttons - vertical stack -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Button Content="▶  Bắt Đầu Trò Chơi Mới" 
                                Command="{Binding StartGameCommand}" 
                                Width="340" Height="54"
                                Margin="0,4,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStartingGame}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Name="StartBlinkStoryboard">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.15" AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="StartBlinkStoryboard"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="⟳  Tiếp Tục Trò Chơi" 
                                Command="{Binding ContinueGameCommand}" 
                                Style="{StaticResource MenuButtonStyle}" 
                                IsEnabled="{Binding IsStartingGame, Converter={StaticResource InverseBoolConverter}}"
                                Width="340" Height="54"
                                Margin="0,8,0,0"/>
                        <Button Content="⚙  Cài Đặt" 
                                Command="{Binding OpenSettingsCommand}" 
                                Style="{StaticResource MenuButtonStyle}" 
                                IsEnabled="{Binding IsStartingGame, Converter={StaticResource InverseBoolConverter}}"
                                Width="340" Height="54"
                                Margin="0,8,0,0"/>

                        <!-- Gold separator before exit -->
                        <Border Height="1" Margin="40,14,40,6" Opacity="0.4">
                            <Border.Background>
                                <SolidColorBrush Color="#FFD700"/>
                            </Border.Background>
                        </Border>

                        <Button Content="✕  Thoát" 
                                Command="{Binding ExitApplicationCommand}" 
                                Style="{StaticResource MenuButtonStyle}" 
                                IsEnabled="{Binding IsStartingGame, Converter={StaticResource InverseBoolConverter}}"
                                Width="340" Height="48"
                                Margin="0,0,0,0"
                                Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <!-- Footer -->
                    <TextBlock Text="Ai Là Triệu Phú · .NET Edition" 
                               FontSize="11"
                               FontFamily="Segoe UI"
                               Foreground="#44FFD700"
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- Millionaire Celebration Overlay                     -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsMillionaireCelebration, Converter={StaticResource BoolToVis}}"
              IsHitTestVisible="False" Panel.ZIndex="100">
            
            <Border x:Name="CelebrationBg" Background="White" Opacity="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMillionaireCelebration}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.8" To="0" Duration="0:0:1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            
            <!-- Placeholder for fireworks, users can replace with a MediaElement or gif -->
            <TextBlock x:Name="TrieuPhuText" Text="🎉 CHÚC MỪNG TRIỆU PHÚ! 🎉" 
                       FontSize="48" FontWeight="Black" FontFamily="Segoe UI"
                       Foreground="#FFFFD700" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <ScaleTransform ScaleX="0" ScaleY="0"/>
                </TextBlock.RenderTransform>
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FF0000" BlurRadius="25" ShadowDepth="0" Opacity="1"/>
                </TextBlock.Effect>
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMillionaireCelebration}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.1" To="1" Duration="0:0:1.5">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase EasingMode="EaseOut" Oscillations="4" Springiness="5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.1" To="1" Duration="0:0:1.5">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase EasingMode="EaseOut" Oscillations="4" Springiness="5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            
            <!-- Firework Sprite Animation -->
            <views:FireworkEffectControl IsActive="{Binding IsMillionaireCelebration}"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"/>
        </Grid>
    </Grid>
</UserControl>