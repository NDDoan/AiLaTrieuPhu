<UserControl x:Class="AiLaTrieuPhu.Views.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AiLaTrieuPhu.Views"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280">

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- Slider Track Style                                 -->
        <!-- ══════════════════════════════════════════════════ -->
        <Style x:Key="GoldSliderStyle" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#FFFF8C00" Offset="0"/>
                                                            <GradientStop Color="#FFFFD700" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" Background="#33FFFFFF"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="20" Height="20" Fill="#FFFFD700">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#FFD700" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- ComboBox Style                                     -->
        <!-- ══════════════════════════════════════════════════ -->
        <Style x:Key="GoldComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF111136"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentGoldBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="12,6,6,6"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="▼" Foreground="{StaticResource AccentGoldBrush}"
                                               Margin="0,0,12,0" VerticalAlignment="Center" FontSize="12"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="#FF0D0D28"
                                        BorderBrush="{StaticResource AccentGoldBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentGoldLightBrush}"/>
                                <Setter TargetName="ComboBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFD700" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF1A1A50"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentGoldBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FF1A1A50"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentGoldBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Section label style -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource MainBackgroundGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- Header                                             -->
        <!-- ══════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,40,0,10">
            <TextBlock Text="⚙  CÀI ĐẶT TRÒ CHƠI" 
                       FontSize="36" 
                       FontWeight="Black"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFF8C00" Offset="0"/>
                        <GradientStop Color="#FFFFD700" Offset="0.5"/>
                        <GradientStop Color="#FFFF8C00" Offset="1"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FFD700" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                </TextBlock.Effect>
            </TextBlock>
            <!-- Header divider -->
            <Border Height="2" Margin="0,12,0,0" CornerRadius="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFD700" Offset="0"/>
                        <GradientStop Color="#FFFFD700" Offset="0.3"/>
                        <GradientStop Color="#FFFFD700" Offset="0.7"/>
                        <GradientStop Color="#00FFD700" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </StackPanel>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- Settings Content                                   -->
        <!-- ══════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="660" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20">

                <!-- SECTION: Âm Thanh -->
                <Border CornerRadius="12" Padding="28,20" Margin="0,0,0,20">
                    <Border.Background>
                        <SolidColorBrush Color="#CC0D0D28"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#44FFD700" Offset="0"/>
                            <GradientStop Color="#22FFD700" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>

                    <StackPanel>
                        <!-- Section title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🔊" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="ÂM THANH" 
                                       Foreground="{StaticResource AccentGoldBrush}" 
                                       FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Music -->
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="Nhạc Nền (Music)" Style="{StaticResource SectionLabelStyle}"/>
                            <Slider Value="{Binding CurrentSettings.MusicVolume, Mode=TwoWay}" 
                                    Minimum="0" Maximum="100" 
                                    TickFrequency="1" IsSnapToTickEnabled="True" 
                                    Width="320" 
                                    Style="{StaticResource GoldSliderStyle}"/>
                            <Border Width="58" Margin="14,0,0,0">
                                <TextBlock Text="{Binding CurrentSettings.MusicVolume, StringFormat={}{0}%}" 
                                           Foreground="{StaticResource AccentGoldBrush}" 
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           FontSize="16"
                                           TextAlignment="Right" 
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- SFX -->
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="Hiệu Ứng (SFX)" Style="{StaticResource SectionLabelStyle}"/>
                            <Slider Value="{Binding CurrentSettings.SfxVolume, Mode=TwoWay}" 
                                    Minimum="0" Maximum="100" 
                                    TickFrequency="1" IsSnapToTickEnabled="True" 
                                    Width="320" 
                                    Style="{StaticResource GoldSliderStyle}"/>
                            <Border Width="58" Margin="14,0,0,0">
                                <TextBlock Text="{Binding CurrentSettings.SfxVolume, StringFormat={}{0}%}" 
                                           Foreground="{StaticResource AccentGoldBrush}" 
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           FontSize="16"
                                           TextAlignment="Right" 
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Voice -->
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="Lồng Tiếng (Voice)" Style="{StaticResource SectionLabelStyle}"/>
                            <Slider Value="{Binding CurrentSettings.VoiceVolume}" 
                                    Minimum="0" Maximum="100" 
                                    TickFrequency="1" IsSnapToTickEnabled="True" 
                                    Width="320" 
                                    Style="{StaticResource GoldSliderStyle}"/>
                            <Border Width="58" Margin="14,0,0,0">
                                <TextBlock Text="{Binding CurrentSettings.VoiceVolume, StringFormat={}{0}%}" 
                                           Foreground="{StaticResource AccentGoldBrush}" 
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           FontSize="16"
                                           TextAlignment="Right" 
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION: Hiển Thị -->
                <Border CornerRadius="12" Padding="28,20" Margin="0,0,0,20">
                    <Border.Background>
                        <SolidColorBrush Color="#CC0D0D28"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#44FFD700" Offset="0"/>
                            <GradientStop Color="#22FFD700" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>

                    <StackPanel>
                        <!-- Section title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🖥" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="HIỂN THỊ" 
                                       Foreground="{StaticResource AccentGoldBrush}" 
                                       FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Resolution -->
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="Độ Phân Giải" Style="{StaticResource SectionLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding AvailableResolutions}" 
                                      SelectedItem="{Binding CurrentSettings.SelectedResolution}"
                                      Width="320" 
                                      Style="{StaticResource GoldComboBoxStyle}"/>
                        </StackPanel>

                        <!-- Display Mode -->
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="Chế Độ Màn Hình" Style="{StaticResource SectionLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding DisplayModes}" 
                                      SelectedItem="{Binding CurrentSettings.CurrentDisplayMode}"
                                      Width="320" 
                                      Style="{StaticResource GoldComboBoxStyle}"/>
                        </StackPanel>

                        <!-- Apply button -->
                        <Button Content="Áp Dụng Thay Đổi Hiển Thị" 
                                Command="{Binding ApplyDisplayChangesCommand}" 
                                Style="{StaticResource MenuButtonStyle}" 
                                Margin="0,16,0,0" Width="320" HorizontalAlignment="Left"
                                Height="46" FontSize="16"/>
                    </StackPanel>
                </Border>

                <!-- SECTION: Khác -->
                <Border CornerRadius="12" Padding="28,20" Margin="0,0,0,20">
                    <Border.Background>
                        <SolidColorBrush Color="#CC0D0D28"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#44FFD700" Offset="0"/>
                            <GradientStop Color="#22FFD700" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>

                    <StackPanel>
                        <!-- Section title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="⚙" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="TÍNH NĂNG KHÁC" 
                                       Foreground="{StaticResource AccentGoldBrush}" 
                                       FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Timer Toggle -->
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="Hiện thanh thời gian" Style="{StaticResource SectionLabelStyle}"/>
                            <CheckBox IsChecked="{Binding CurrentSettings.IsTimerVisible, Mode=TwoWay}"
                                      Content="Bật/Tắt thanh thời gian (ms)"
                                      Foreground="White"
                                      FontSize="16" FontFamily="Segoe UI"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- Footer — Back Button                               -->
        <!-- ══════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Margin="0,0,0,30" HorizontalAlignment="Center">
            <Button Content="◀  QUAY LẠI" 
                    Command="{Binding BackToMenuCommand}" 
                    Style="{StaticResource MenuButtonStyle}" 
                    Width="280" Height="52" FontSize="18"/>
        </Border>

    </Grid>
</UserControl>
