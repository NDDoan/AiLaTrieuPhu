<UserControl x:Class="AiLaTrieuPhu.Views.GameScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:AiLaTrieuPhu.ViewModels"
             xmlns:local="clr-namespace:AiLaTrieuPhu.Views" xmlns:util="clr-namespace:AiLaTrieuPhu.Utilities"
             mc:Ignorable="d" 
             Background="{StaticResource PrimaryBackgroundBrush}">

    <UserControl.Resources>
        <util:IndexToCommandParameterConverter x:Key="IndexConverter"/>
        <util:IndexToRowConverter x:Key="IndexToRowConverter"/>
        <util:IndexToColumnConverter x:Key="IndexToColumnConverter"/>
        <util:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <util:BoolToDiamondConverter x:Key="BoolToDiamondConverter"/>
        <util:BoolToHighlightColorConverter x:Key="BoolToHighlightColorConverter"/>
        <util:BoolToBoldConverter x:Key="BoolToBoldConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border BorderBrush="{StaticResource AccentGoldBrush}" BorderThickness="1" Width="180" Height="180">
                    <TextBlock Text="Hình của bạn" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border BorderBrush="{StaticResource AccentGoldBrush}" BorderThickness="1" Width="180" Height="180">
                    <TextBlock Text="Hình của Lại Văn Sâm" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="{StaticResource AccentGoldBrush}" BorderThickness="1" CornerRadius="15" Margin="0,20,0,0" Padding="10">
                <TextBlock Text="Phụ đề hội thoại" Foreground="White" TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </Border>
        </Grid>

        <Grid Grid.Column="1" Margin="20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding GameStatusMessage}" 
                           Foreground="White" FontSize="20" FontWeight="SemiBold" 
                           VerticalAlignment="Center" Margin="0,0,30,0"/>
                <Button Content="Thoát game" Command="{Binding SaveAndExitCommand}" Style="{StaticResource MenuButtonStyle}" Width="150" Height="40" HorizontalAlignment="Right"/>
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="{StaticResource AccentGoldBrush}" BorderThickness="2" CornerRadius="15" Margin="0,20" Padding="20">
                <TextBlock Text="{Binding CurrentQuestion.QuestionText}" 
                           Foreground="White" FontSize="32" TextWrapping="Wrap" 
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Button Content="50:50" Margin="10,0" Style="{StaticResource MenuButtonStyle}" Width="100" Height="40"/>
                    <Button Content="Gọi" Margin="10,0" Style="{StaticResource MenuButtonStyle}" Width="100" Height="40"/>
                    <Button Content="Khán giả" Margin="10,0" Style="{StaticResource MenuButtonStyle}" Width="100" Height="40"/>

                    <Button Content="Tư vấn" Margin="10,0" Style="{StaticResource MenuButtonStyle}" Width="100" Height="40"
                            Visibility="{Binding IsConsultancyVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding CurrentQuestion.Options}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                            </Grid>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Grid.Row" Value="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToRowConverter}}"/>
                            <Setter Property="Grid.Column" Value="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToColumnConverter}}"/>
                            <Setter Property="Margin" Value="10"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.AlternationCount>4</ItemsControl.AlternationCount>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" 
                                    Style="{StaticResource AnswerButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    
                                    Command="{Binding DataContext.AnswerCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    IsEnabled="{Binding DataContext.IsAnswerPhase, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">

                                <Button.CommandParameter>
                                    <MultiBinding Converter="{StaticResource IndexConverter}">
                                        <Binding RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type ContentPresenter}}"/>
                                        <Binding RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type ItemsControl}}"/>
                                    </MultiBinding>
                                </Button.CommandParameter>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <Border Grid.Column="2" Margin="10" BorderBrush="{StaticResource AccentGoldBrush}" BorderThickness="1" CornerRadius="10">
            <ListBox ItemsSource="{Binding PrizeLadderDisplay}" 
                     Background="Transparent" BorderThickness="0" 
                     HorizontalContentAlignment="Stretch" VerticalAlignment="Top">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="20"/>
                        <Setter Property="Padding" Value="5"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentGoldBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSafePoint}" Value="True">
                                <Setter Property="Background" Value="{StaticResource SuccessGreenBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding IsAnswered, Converter={StaticResource BoolToDiamondConverter}}" 
                                       Margin="0,0,10,0"/>

                            <TextBlock Grid.Column="1" Text="{Binding QuestionNumber, StringFormat={}{0}. }" 
                                       HorizontalAlignment="Left" FontWeight="SemiBold"/>

                            <TextBlock Grid.Column="2" Text="{Binding PrizeAmount, StringFormat={}{0:N0} VNĐ}" 
                                        HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate> 
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
