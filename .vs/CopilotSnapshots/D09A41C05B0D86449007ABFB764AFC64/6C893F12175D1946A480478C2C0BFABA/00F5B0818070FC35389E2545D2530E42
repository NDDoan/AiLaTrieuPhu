<UserControl x:Class="AiLaTrieuPhu.Views.MenuScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:AiLaTrieuPhu.Utilities"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             Background="{StaticResource PrimaryBackgroundBrush}">
    <UserControl.Resources>
        <converters:IndexToRandomPosConverter x:Key="IndexToRandomPosConverter"/>
        <converters:CenterConverter x:Key="CenterConverter"/>

        <x:Array x:Key="NostalgiaImages" Type="System:String">
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_1.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_2.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_3.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_4.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_5.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_6.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_7.png</System:String>
        </x:Array>

        <Storyboard x:Key="FloatingImageAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(Canvas.Left)" From="0" To="1280" Duration="0:0:50" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetProperty="(Canvas.Top)" From="0" To="720" Duration="0:0:40" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleX)" From="0.8" To="1.2" Duration="0:0:25" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetProperty="(Image.RenderTransform).(ScaleTransform.ScaleY)" From="0.8" To="1.2" Duration="0:0:25" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="0.7" Duration="0:0:18" AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Key="LogoPulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.99" To="1.01" Duration="0:0:5" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.99" To="1.01" Duration="0:0:5" AutoReverse="True"/>
        </Storyboard>

    </UserControl.Resources>

    <Grid>
        <Canvas x:Name="FloatingCanvas">
            <ItemsControl x:Name="NostalgiaItems" ItemsSource="{StaticResource NostalgiaImages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding}" 
                               Width="150" Height="150" 
                               RenderTransformOrigin="0.5, 0.5">
                            <Image.RenderTransform>
                                <ScaleTransform/>
                            </Image.RenderTransform>
                        </Image>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToRandomPosConverter}}"/>
                        <Setter Property="Canvas.Top" Value="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToRandomPosConverter}, ConverterParameter='1'}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.AlternationCount>7</ItemsControl.AlternationCount>
            </ItemsControl>

            <Image x:Name="MenuLogo" Source="/AiLaTrieuPhu;component/Assets/Image/ALTP_LOGO.png" Width="400" Height="400" 
                   Opacity="0.8" 
                   RenderTransformOrigin="0.5, 0.5"
                   Canvas.Left="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Canvas}, Path=ActualWidth, Converter={StaticResource CenterConverter}, ConverterParameter=400}"
                   Canvas.Top="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Canvas}, Path=ActualHeight, Converter={StaticResource CenterConverter}, ConverterParameter=400}">
                <Image.RenderTransform>
                    <ScaleTransform/>
                </Image.RenderTransform>
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource LogoPulseAnimation}"/>
                    </EventTrigger>
                </Image.Triggers>
            </Image>
        </Canvas>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="AI LÀ TRIỆU PHÚ" FontSize="48" FontWeight="Bold" Foreground="{StaticResource AccentGoldBrush}" Margin="0,0,0,50" HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding StatusMessage}" 
                       FontSize="28" 
                       Foreground="White" 
                       Margin="0,0,0,30" 
                       HorizontalAlignment="Center" 
                       FontWeight="SemiBold"/>

            <Button Content="Bắt Đầu Trò Chơi Mới" 
                    Command="{Binding StartGameCommand}" 
                    Style="{StaticResource MenuButtonStyle}"/>

            <Button Content="Tiếp Tục Trò Chơi" 
                    Command="{Binding ContinueGameCommand}"
                    Style="{StaticResource MenuButtonStyle}" Margin="0,10,0,10"/>

            <Button Content="Cài Đặt" 
                    Command="{Binding OpenSettingsCommand}" 
                    Style="{StaticResource MenuButtonStyle}"/>

            <Button Content="Thoát" 
                    Command="{Binding ExitApplicationCommand}" 
                    Style="{StaticResource MenuButtonStyle}" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>