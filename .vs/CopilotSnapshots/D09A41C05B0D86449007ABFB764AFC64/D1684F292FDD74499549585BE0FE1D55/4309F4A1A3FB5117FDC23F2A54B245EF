<UserControl x:Class="AiLaTrieuPhu.Views.MenuScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:AiLaTrieuPhu.Utilities"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             Background="{StaticResource PrimaryBackgroundBrush}">
    <UserControl.Resources>
        <converters:IndexToRandomPosConverter x:Key="IndexToRandomPosConverter"/>
        <converters:CenterConverter x:Key="CenterConverter"/>

        <x:Array x:Key="NostalgiaImages" Type="System:String">
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_1.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_2.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_3.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_4.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_5.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_6.png</System:String>
            <System:String>/AiLaTrieuPhu;component/Assets/Image/ALTP_Nostalgia_7.png</System:String>
        </x:Array>

        <!-- Floating animations target RenderTransform.Children[0] (floating translate) -->
        <Storyboard x:Key="FloatingImageAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.X)"
                             From="-30" To="30" Duration="0:0:8" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)"
                             From="-20" To="20" Duration="0:0:6" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(ScaleTransform.ScaleX)"
                             From="0.9" To="1.05" Duration="0:0:10" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(ScaleTransform.ScaleY)"
                             From="0.9" To="1.05" Duration="0:0:10" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(RotateTransform.Angle)"
                             From="-5" To="5" Duration="0:0:12" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="0.85" Duration="0:0:9" AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Key="LogoPulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.99" To="1.01" Duration="0:0:5" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.99" To="1.01" Duration="0:0:5" AutoReverse="True"/>
        </Storyboard>

    </UserControl.Resources>

    <Grid>
        <!-- Background floating canvas -->
        <Canvas x:Name="FloatingCanvas">
            <ItemsControl x:Name="NostalgiaItems" ItemsSource="{StaticResource NostalgiaImages}" AlternationCount="7">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding}" 
                               Width="140" Height="Auto" 
                               RenderTransformOrigin="0.5, 0.5"
                               Cursor="Hand">
                            <Image.RenderTransform>
                                <!-- Order: FloatingTranslate, DragTranslate, Scale, Rotate -->
                                <TransformGroup>
                                    <TranslateTransform />
                                    <TranslateTransform />
                                    <ScaleTransform />
                                    <RotateTransform />
                                </TransformGroup>
                            </Image.RenderTransform>
                            <Image.Effect>
                                <DropShadowEffect Color="#80000000" BlurRadius="8" ShadowDepth="3"/>
                            </Image.Effect>
                        </Image>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToRandomPosConverter}}"/>
                        <Setter Property="Canvas.Top" Value="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToRandomPosConverter}, ConverterParameter='1'}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>

            <!-- Keep floating images behind UI; logo is above canvas via overlay panel below -->
        </Canvas>

        <!-- Overlay UI centered -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="True">
            <Border Background="#AA000000" CornerRadius="12" Padding="24" Width="520">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="MenuLogo" Source="/AiLaTrieuPhu;component/Assets/Image/ALTP_LOGO.png" Width="220" Height="220" 
                           Opacity="0.95" 
                           Stretch="Uniform"
                           RenderTransformOrigin="0.5, 0.5">
                        <Image.RenderTransform>
                            <ScaleTransform/>
                        </Image.RenderTransform>
                        <Image.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard Storyboard="{StaticResource LogoPulseAnimation}"/>
                            </EventTrigger>
                        </Image.Triggers>
                    </Image>

                    <TextBlock Text="AI LÀ TRIỆU PHÚ" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentGoldBrush}" Margin="0,8,0,16" HorizontalAlignment="Center" TextAlignment="Center"/>

                    <TextBlock Text="{Binding StatusMessage}" 
                               FontSize="20" 
                               Foreground="White" 
                               Margin="0,0,0,16"  
                               HorizontalAlignment="Center"  
                               TextAlignment="Center"/>

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Button Content="Bắt Đầu Trò Chơi Mới" 
                                Command="{Binding StartGameCommand}" 
                                Style="{StaticResource MenuButtonStyle}" Margin="0,6,0,0"/>

                        <Button Content="Tiếp Tục Trò Chơi" 
                                Command="{Binding ContinueGameCommand}"
                                Style="{StaticResource MenuButtonStyle}" Margin="0,10,0,0"/>

                        <Button Content="Cài Đặt" 
                                Command="{Binding OpenSettingsCommand}" 
                                Style="{StaticResource MenuButtonStyle}" Margin="0,10,0,0"/>

                        <Button Content="Thoát" 
                                Command="{Binding ExitApplicationCommand}" 
                                Style="{StaticResource MenuButtonStyle}" Margin="0,10,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>