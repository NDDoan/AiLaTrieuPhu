<UserControl x:Class="AiLaTrieuPhu.Views.MenuScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:AiLaTrieuPhu.Utilities"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             Background="{StaticResource PrimaryBackgroundBrush}">
    <UserControl.Resources>
        <converters:IndexToRandomPosConverter x:Key="IndexToRandomPosConverter"/>
        <converters:CenterConverter x:Key="CenterConverter"/>

        <x:Array x:Key="NostalgiaImages" Type="System:String">
            <System:String>Assets/Images/ALTP_Nostalgia_1.png</System:String>
            <System:String>Assets/Images/ALTP_Nostalgia_2.png</System:String>
            <System:String>Assets/Images/ALTP_Nostalgia_3.png</System:String>
            <System:String>Assets/Images/ALTP_Nostalgia_4.png</System:String>
            <System:String>Assets/Images/ALTP_Nostalgia_5.png</System:String>
            <System:String>Assets/Images/ALTP_Nostalgia_6.png</System:String>
            <System:String>Assets/Images/ALTP_Nostalgia_7.png</System:String>
        </x:Array>

        <!-- Floating animations now use RenderTransform (Translate/Scale/Rotate) for better performance -->
        <Storyboard x:Key="FloatingImageAnimation" RepeatBehavior="Forever">
            <!-- Translate (drift) -->
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.X)" From="-40" To="40" Duration="0:0:12" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)" From="-30" To="30" Duration="0:0:9" AutoReverse="True" />

            <!-- Slight scale pulsing -->
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)" From="0.9" To="1.08" Duration="0:0:10" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)" From="0.9" To="1.08" Duration="0:0:10" AutoReverse="True" />

            <!-- Slow rotation -->
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)" From="-6" To="6" Duration="0:0:14" AutoReverse="True" />

            <!-- Opacity shimmer -->
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="0.8" Duration="0:0:8" AutoReverse="True" />
        </Storyboard>

        <Storyboard x:Key="LogoPulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.99" To="1.01" Duration="0:0:5" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.99" To="1.01" Duration="0:0:5" AutoReverse="True"/>
        </Storyboard>

    </UserControl.Resources>

    <Grid>
        <Canvas x:Name="FloatingCanvas">
            <ItemsControl ItemsSource="{StaticResource NostalgiaImages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Use uniform stretch and bitmap caching to preserve aspect and improve rendering performance -->
                        <Image Source="{Binding}"
                               Width="120"
                               Height="Auto"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               CacheMode="BitmapCache"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <!-- Order: Translate, Scale, Rotate -->
                                <TransformGroup>
                                    <TranslateTransform />
                                    <ScaleTransform />
                                    <RotateTransform />
                                </TransformGroup>
                            </Image.RenderTransform>
                            <Image.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource FloatingImageAnimation}"/>
                                </EventTrigger>
                            </Image.Triggers>
                        </Image>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <!-- Keep initial absolute placement via Canvas.Left/Top; animation uses TranslateTransform to move relative to that starting point -->
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">                        <Setter Property="Canvas.Left" Value="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToRandomPosConverter}}"/>                        <Setter Property="Canvas.Top" Value="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToRandomPosConverter}, ConverterParameter='1'}"/>                    </Style>                </ItemsControl.ItemContainerStyle>                <ItemsControl.AlternationCount>7</ItemsControl.AlternationCount>            </ItemsControl>            <!-- Logo: keep centered but optimize caching and scaling -->            <Image x:Name="MenuLogo" Source="Assets/Images/ALTP_LOGO.png" Width="400" Height="Auto"                    Opacity="0.9"                    Stretch="Uniform"                   RenderOptions.BitmapScalingMode="HighQuality"                   CacheMode="BitmapCache"                   RenderTransformOrigin="0.5, 0.5"                   Canvas.Left="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Canvas}, Path=ActualWidth, Converter={StaticResource CenterConverter}, ConverterParameter=400}"                   Canvas.Top="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Canvas}, Path=ActualHeight, Converter={StaticResource CenterConverter}, ConverterParameter=400}">                <Image.RenderTransform>                    <ScaleTransform/>                </Image.RenderTransform>                <Image.Triggers>                    <EventTrigger RoutedEvent="Loaded">                        <BeginStoryboard Storyboard="{StaticResource LogoPulseAnimation}"/>                    </EventTrigger>                </Image.Triggers>            </Image>        </Canvas>        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">            <TextBlock Text="AI LÀ TRIỆU PHÚ" FontSize="48" FontWeight="Bold" Foreground="{StaticResource AccentGoldBrush}" Margin="0,0,0,50" HorizontalAlignment="Center"/>            <TextBlock Text="{Binding StatusMessage}"                        FontSize="28"                        Foreground="White"                        Margin="0,0,0,30"                        HorizontalAlignment="Center"                        FontWeight="SemiBold"/>            <Button Content="Bắt Đầu Trò Chơi Mới"                     Command="{Binding StartGameCommand}"                     Style="{StaticResource MenuButtonStyle}"/>            <Button Content="Tiếp Tục Trò Chơi"                     Command="{Binding ContinueGameCommand}"                    Style="{StaticResource MenuButtonStyle}" Margin="0,10,0,10"/>            <Button Content="Cài Đặt"                     Command="{Binding OpenSettingsCommand}"                     Style="{StaticResource MenuButtonStyle}"/>            <Button Content="Thoát"                     Command="{Binding ExitApplicationCommand}"                     Style="{StaticResource MenuButtonStyle}" Margin="0,10,0,0"/>        </StackPanel>    </Grid></UserControl>